# ─── Swara Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit your actual passphrase hash.

# ── Passphrase hash ─────────────────────────────────────────────────────────
# SHA-256 hex hash of your chosen passphrase (lowercase, no spaces).
#
# To generate:
#   macOS/Linux: echo -n "yourpassphrase" | sha256sum | awk '{print $1}'
#   Node.js:     require('crypto').createHash('sha256').update('yourpassphrase').digest('hex')
#
# The default value below is the hash for "swara" — CHANGE THIS.
NEXT_PUBLIC_PASSPHRASE_HASH=a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3

# ── Music database repo ──────────────────────────────────────────────────────
# The public GitHub repo where your music releases live.
# Format: owner/repo
NEXT_PUBLIC_MUSIC_DB_REPO=gajala-sonic-solutions/m4a-db

# ── Base path (only if deploying to a subdirectory) ──────────────────────────
# Example: if your app lives at username.github.io/swara, set:
#   NEXT_PUBLIC_BASE_PATH=/swara
# Leave empty if deploying to root (username.github.io or custom domain).
NEXT_PUBLIC_BASE_PATH=/swara
